# Firebase / Google Cloud project used by the Functions emulator and Vertex AI.
ECOEATS_FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional overrides. These values are not secrets.
ECOEATS_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
ECOEATS_FUNCTIONS_REGION=us-central1
ECOEATS_VERTEX_AI_LOCATION=us-central1
ECOEATS_EMULATOR_HOST=127.0.0.1:5001

# Local-only: absolute path to a service-account JSON key. Do not commit it.
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
